{
  "name": "minwari",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "local": "NEXT_PUBLIC_APP_ENV=local next dev",
    "prod": "NEXT_PUBLIC_APP_ENV=production next dev",
    "build": "next build --webpack",
    "start": "tsx server/api/index.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "api:local": "PORT=8081 tsx watch server/api/index.ts",
    "postbuild": "node --import tsx scripts/seo-files.mjs",
    "preview": "node --import tsx scripts/preview.mjs"
  },
  "dependencies": {
    "@heroui/button": "^2.2.29",
    "@heroui/checkbox": "^2.3.29",
    "@heroui/chip": "^2.2.24",
    "@heroui/input": "^2.4.30",
    "@heroui/react": "^2.8.0",
    "@heroui/select": "^2.4.30",
    "@heroui/theme": "^2.4.25",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.562.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
